{
  "name": "TapTally (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postCreateCommand": "npm install",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Metro Bundler",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "expo.vscode-expo-tools"
      ]
    }
  },
  "remoteEnv": {
    "EXPO_NO_TELEMETRY": "1"
  }
}
